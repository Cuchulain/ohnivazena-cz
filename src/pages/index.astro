---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={SITE.title} description={SITE.desc}>
  <Header />
  <main id="main-content" class="app-layout">

    <!-- Hero sekce -->
    <section id="hero" class="pt-12 pb-10 border-b border-border text-center">
      <!-- Logo naraJana — inline SVG pro podporu webového fontu -->
      <div class="flex justify-center mb-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 460 175"
          aria-label="naráJana"
          role="img"
          class="max-w-[360px] w-full h-auto"
        >
          <defs>
            <style>
              .logo-text {
                font-family: 'Rajdhani', 'Montserrat', Arial, sans-serif;
                font-weight: 600;
                fill: #d4620f;
                letter-spacing: 0.06em;
                font-size: 62px;
              }
            </style>
          </defs>
          <!-- Srdíčko nad J — odsazené vyše -->
          <path
            d="M230,10 C230,10 224,3 218,6 C212,9 212,17 218,22 L230,30 L242,22 C248,17 248,9 242,6 C236,3 230,10 230,10 Z"
            fill="#d4620f"
          />
          <!-- J — patička nahoře + svislá čára se smyčkou -->
          <path
            d="M222,42 L238,42 M230,42 L230,118 Q230,158 210,163 Q190,168 188,150"
            stroke="#d4620f"
            stroke-width="4.5"
            stroke-linecap="round"
            fill="none"
          />
          <!-- NARA vlevo — končí těsně před J -->
          <text x="224" y="102" text-anchor="end" class="logo-text">NARÁ</text>
          <!-- ANA vpravo — začíná těsně za J -->
          <text x="236" y="102" text-anchor="start" class="logo-text">ANA</text>
        </svg>
      </div>

      <h1 class="sr-only">Ohnivá žena — naraJana</h1>

      <p class="mt-4 max-w-xl mx-auto text-lg leading-relaxed text-foreground/80 italic">
        „Pojďme žít sjednoceni se sebou, nalezením spojení se Zemí a Vesmírem."
      </p>

      <div class="mt-8">
        <a
          href="/kdo-jsem/"
          class="rounded bg-accent px-8 py-3 font-semibold text-white hover:opacity-90 transition-opacity"
        >
          Kdo jsem →
        </a>
      </div>

    </section>

    <!-- Oblast zaměření — stručně -->
    <section class="py-10 border-b border-border">
      <h2 class="text-2xl font-semibold text-center mb-8">Co mě naplňuje</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
        <div class="rounded-lg border border-border bg-muted/40 p-5">
          <h3 class="font-semibold text-accent mb-2">🌿 Magie Země</h3>
          <p class="text-sm leading-relaxed">Obřady, spolupráce s přírodou, přírodní cykly a živly. Ukotvení v těle a v zemi pod nohama.</p>
        </div>
        <div class="rounded-lg border border-border bg-muted/40 p-5">
          <h3 class="font-semibold text-accent mb-2">✨ Magie Vesmíru</h3>
          <p class="text-sm leading-relaxed">Andělé, archandělé, nanebevzetí mistři a vesmírné energie. Propojení s vyšším vědomím.</p>
        </div>
        <div class="rounded-lg border border-border bg-muted/40 p-5">
          <h3 class="font-semibold text-accent mb-2">🌱 Šetrné zdraví</h3>
          <p class="text-sm leading-relaxed">Alternativy ke klasické medicíně, homeopatie, RAW výživa. Tělo jako chrám duše.</p>
        </div>
        <div class="rounded-lg border border-border bg-muted/40 p-5">
          <h3 class="font-semibold text-accent mb-2">👶 Péče o děti</h3>
          <p class="text-sm leading-relaxed">Individuální vzdělávání, domácí porody, přirozené rodičovství. Děti jako respektované bytosti.</p>
        </div>
      </div>
    </section>

    <!-- Svědectví -->
    <section class="py-10 border-b border-border">
      <h2 class="text-2xl font-semibold text-center mb-8">Napsali o mně</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <figure class="rounded-lg border border-border bg-muted/30 p-5">
          <blockquote class="text-sm leading-relaxed italic text-foreground/80">
            „Spolupráce s Janinkou je skvělá. Hledala jsem východisko z komplikovaných vztahů s muži a našla. Cítím se svěže, svobodně, blíž své přirozenosti."
          </blockquote>
          <figcaption class="mt-3 text-xs font-medium text-accent">— Kristýna Magnusková</figcaption>
        </figure>
        <figure class="rounded-lg border border-border bg-muted/30 p-5">
          <blockquote class="text-sm leading-relaxed italic text-foreground/80">
            „Parádní spolupráce. Nádherné uvolnění. Hodinka utekla jako nic. Mám hned lepší den a věřím, že to tak bude už pořád."
          </blockquote>
          <figcaption class="mt-3 text-xs font-medium text-accent">— Ianete</figcaption>
        </figure>
        <figure class="rounded-lg border border-border bg-muted/30 p-5">
          <blockquote class="text-sm leading-relaxed italic text-foreground/80">
            „Plnohodnotné rady od úžasné ženy. Je úžasná žena, která umí vždy moudře poradit."
          </blockquote>
          <figcaption class="mt-3 text-xs font-medium text-accent">— Pavlína</figcaption>
        </figure>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-10 text-center">
      <a
        href="/cim-se-zabyvam/"
        class="rounded bg-accent px-8 py-3 font-semibold text-white hover:opacity-90 transition-opacity"
      >
        Čím se zabývám →
      </a>
    </section>

  </main>
  <Footer />
</Layout>

